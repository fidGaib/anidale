[Unit]
# AniDale: сервер приложения под systemd.
# Пути /srv/anidale замените на свои. Установка:
#   sudo cp deploy/anidale.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now anidale
Description=AniDale server
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=anidale
Group=anidale
WorkingDirectory=/srv/anidale/server
EnvironmentFile=/srv/anidale/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/start.mjs --prod dist/index.js
Restart=always
RestartSec=3
# Сокетам нужно время, чтобы закрыться штатно
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65535

# Сервер пишет только в storage и во временный каталог
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anidale/server/storage

[Install]
WantedBy=multi-user.target
