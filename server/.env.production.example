# Боевые настройки сервера. Скопируйте в .env на сервере и подставьте свои значения.
# Файл .env в репозиторий не попадает (см. .gitignore); значения ниже — только примеры.

# Режим: без интроспекции GraphQL, с Secure-куками и HSTS. Его же включает `npm run start:prod`.
NODE_ENV=production

PORT=5000

# Отдельный пользователь базы с длинным паролем и правами только на базу anidale (не postgres!).
# Создать: CREATE ROLE anidale LOGIN PASSWORD '<длинный пароль>'; CREATE DATABASE anidale OWNER anidale;
DB_LINK=postgresql://anidale:<длинный-пароль>@127.0.0.1:5432/anidale?schema=public

# Redis: кэш каталога и музыки, онлайн-статусы, ограничители частоты.
# Пустое значение — работа без Redis: кэш выключен, лимиты считаются в PostgreSQL,
# онлайн-статусы хранятся в памяти процесса.
# Redis должен слушать только 127.0.0.1; наружу порт 6379 не открывайте.
REDIS_URL=redis://127.0.0.1:6379

# Резервные копии (scripts/backup.mjs): куда складывать и сколько дней хранить.
# BACKUP_DIR=/var/backups/anidale
# BACKUP_KEEP_DAYS=14

# Секреты токенов: у каждого свои, не короче 64 случайных символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Добавка к паролям перед хэшированием. Не меняйте её после запуска: все пароли перестанут подходить.
# Для нового сервера — не короче 32 случайных символов.
PASS_PEPPER=

# Адрес сайта (https!): разрешён для CORS и сокетов, куки уходят только с него.
CLIENT_URL=https://anidale.example
API_URL=https://anidale.example

# Почта для подтверждения адреса и сброса пароля (Яндекс, Mail.ru, Resend, SendGrid и т. п.).
# Без SMTP_HOST письма не отправляются, а ссылки печатаются в консоль сервера — это только для разработки.
# Яндекс: smtp.yandex.ru:465, пароль — «пароль приложения», а не пароль от почты.
SMTP_HOST=
SMTP_PORT=465
# 1 — сразу TLS (порт 465), 0 — STARTTLS (обычно 587). Пусто — определить по порту.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Отправитель в письмах. Для Яндекса адрес должен совпадать с SMTP_USER.
SMTP_FROM=AniDale <no-reply@anidale.example>

# Сервер стоит за nginx: адрес клиента берём из X-Forwarded-For (иначе лимиты считались бы по адресу nginx).
# Включайте, только если порт 5000 закрыт от внешней сети и до него доходит один nginx.
TRUST_PROXY=1
