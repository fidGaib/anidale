// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DB_LINK")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  pass        String
  login       String
  avatar      String
  activationLink String?
  isActivated Boolean
  createdAt   DateTime @default(now())
  posts       Post[]
  tokens      Token[]
  musics      Music[]
}

model Music {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime @default(now())
  image       String
  owner       Int
  user        User     @relation(fields: [owner], references: [id])

  @@index([owner])
}
model Post {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime @default(now())
  images      PostImage[]
  owner      Int
  user        User     @relation(fields: [owner], references: [id])

  @@index([owner])
}

model PostImage {
  id          Int      @id @default(autoincrement())
  high      String
  medium    String
  small     String
  type      String
  vertical  Boolean
  date      DateTime @default(now())
  post      Post   @relation(fields: [postId], references: [id])
  postId    Int

  @@index([postId])
  @@index([medium])
}


model Token {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  refreshToken String

  @@index([userId])
  @@index([refreshToken])
}