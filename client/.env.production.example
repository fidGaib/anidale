# Сборка для продакшена (`npm run build`). Значения подставляются в код при сборке.

# Тот же домен, что и у сайта: запросы к API идут через nginx, куки считаются своими.
VITE_API_URL=https://anidale.example

# Файлы (/storage, иконки) отдаёт тот же nginx. Пустое значение = относительные пути, тот же origin, что у сайта.
VITE_STATIC_URL=
