# Скопируйте этот файл в .env и подставьте свои значения.

# Базовый адрес API (GraphQL и socket.io)
VITE_API_URL=http://localhost:5000

# Базовый адрес статики: иконки, картинки, /storage.
# Пустое значение = относительные пути, т.е. тот же origin, что и у фронтенда.
VITE_STATIC_URL=http://localhost

# Сокет, если живёт отдельно от API. По умолчанию равен VITE_API_URL.
# VITE_SOCKET_URL=http://localhost:5000
